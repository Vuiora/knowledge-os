# 工程师知识库 - MkDocs 配置
site_name: 工程师知识库
site_description: 个人工程知识管理系统
site_author: Engineer
site_url: https://knowledge.example.com

# 仓库配置
repo_name: knowledge-system
repo_url: ${REPO_URL}
edit_uri: _edit/main/knowledge/

# 主题配置
theme:
  name: material
  language: zh
  palette:
    # 浅色模式
    - scheme: default
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-7
        name: 切换到深色模式
    # 深色模式
    - scheme: slate
      primary: indigo
      accent: indigo
      toggle:
        icon: material/brightness-4
        name: 切换到浅色模式
  
  # 功能特性
  features:
    - navigation.tabs           # 顶部导航标签
    - navigation.tabs.sticky    # 固定导航标签
    - navigation.sections       # 导航分组
    - navigation.expand         # 默认展开导航
    - navigation.top            # 返回顶部按钮
    - navigation.tracking       # 锚点跟踪
    - search.suggest            # 搜索建议
    - search.highlight          # 搜索高亮
    - search.share              # 搜索分享
    - content.code.copy         # 代码复制按钮
    - content.code.annotate     # 代码注释
    - toc.follow                # 目录跟随
    - toc.integrate             # 目录集成
  
  # 图标
  icon:
    repo: fontawesome/brands/git-alt
    logo: material/book-open-page-variant
  
  # 字体
  font:
    text: Noto Sans SC
    code: Roboto Mono

# 插件
plugins:
  - search:
      lang:
        - zh
        - en
      separator: '[\s\-\.]+'
  - git-revision-date-localized:
      enable_creation_date: true
      type: datetime
      timezone: Asia/Shanghai
      locale: zh
      fallback_to_build_date: true
  - minify:
      minify_html: true
      minify_js: true
      minify_css: true
      htmlmin_opts:
        remove_comments: true

# Markdown 扩展
markdown_extensions:
  # Python Markdown
  - abbr
  - admonition
  - attr_list
  - def_list
  - footnotes
  - md_in_html
  - toc:
      permalink: true
      permalink_title: 锚点链接
      toc_depth: 3
  
  # Python Markdown Extensions
  - pymdownx.arithmatex:
      generic: true
  - pymdownx.betterem:
      smart_enable: all
  - pymdownx.caret
  - pymdownx.details
  - pymdownx.emoji:
      emoji_index: !!python/name:material.extensions.emoji.twemoji
      emoji_generator: !!python/name:material.extensions.emoji.to_svg
  - pymdownx.highlight:
      anchor_linenums: true
      line_spans: __span
      pygments_lang_class: true
  - pymdownx.inlinehilite
  - pymdownx.keys
  - pymdownx.mark
  - pymdownx.smartsymbols
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
  - pymdownx.tabbed:
      alternate_style: true
  - pymdownx.tasklist:
      custom_checkbox: true
  - pymdownx.tilde

# 额外配置
extra:
  # 社交链接
  social:
    - icon: fontawesome/brands/github
      link: https://github.com
      name: GitHub
  
  # 版权信息
  copyright: Copyright &copy; 2024 Engineer Knowledge System
  
  # 分析（可选）
  # analytics:
  #   provider: google
  #   property: G-XXXXXXXXXX

# 额外 CSS
extra_css:
  - stylesheets/extra.css

# 额外 JavaScript
extra_javascript:
  - javascripts/mathjax.js
  - https://polyfill.io/v3/polyfill.min.js?features=es6
  - https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js

# 导航结构
nav:
  - 首页: index.md
  
  - 基础知识:
    - 01-foundations/index.md
    - 操作系统: 01-foundations/operating-system/index.md
    - 网络: 01-foundations/network/index.md
    - 算法: 01-foundations/algorithm/index.md
    - 数据库: 01-foundations/database/index.md
  
  - 技术栈:
    - 02-technologies/index.md
    - 嵌入式:
      - 02-technologies/embedded/index.md
      - MCU: 02-technologies/embedded/mcu/index.md
      - RTOS: 02-technologies/embedded/rtos/index.md
      - 驱动: 02-technologies/embedded/driver/index.md
      - 协议: 02-technologies/embedded/protocol/index.md
    - AI: 02-technologies/ai/index.md
    - 云计算: 02-technologies/cloud/index.md
  
  - 架构设计:
    - 03-architecture/index.md
    - 嵌入式系统: 03-architecture/embedded-system/index.md
    - 分布式系统: 03-architecture/distributed-system/index.md
    - 平台架构: 03-architecture/platform/index.md
  
  - 项目实践:
    - 04-projects/index.md
    - 智能戒指: 04-projects/smart-ring/index.md
    - 防鼾枕: 04-projects/anti-snore-pillow/index.md
  
  - 技术洞察:
    - 05-insights/index.md
    - 工程实践: 05-insights/engineering/index.md
    - 职业发展: 05-insights/career/index.md
    - 技术趋势: 05-insights/technology-trend/index.md

# 严格模式（可选）
# strict: true

# 文档目录（将在运行时设置）
# docs_dir: /app/repo/knowledge
