# 工程师知识系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==========================================
# Gitea 配置
# ==========================================
GITEA_PORT=3001
GITEA_SSH_PORT=2222
GITEA_DOMAIN=localhost
GITEA_USER=admin
GITEA_PASSWORD=your_gitea_password_here
GITEA_TOKEN=your_gitea_api_token_here
GITEA_DB_USER=gitea
GITEA_DB_PASS=your_gitea_db_password_here

# ==========================================
# Wiki.js 配置
# ==========================================
WIKI_PORT=3000
WIKI_DB_USER=wikijs
WIKI_DB_PASS=your_wiki_db_password_here
WIKI_DB_NAME=wiki
WIKI_TOKEN=your_wiki_api_token_here

# Wiki.js Git 同步配置
GIT_SYNC_REPO_URL=http://gitea:3000/admin/knowledge-system.git
GIT_SYNC_BRANCH=main
GIT_SYNC_INTERVAL=PT5M

# ==========================================
# PostgreSQL 配置
# ==========================================
POSTGRES_PASSWORD=your_postgres_password_here

# ==========================================
# Qdrant 配置
# ==========================================
QDRANT_PORT=6333

# ==========================================
# Webhook 配置
# ==========================================
WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# AI 助手配置
# ==========================================
AI_PORT=3003
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ==========================================
# MkDocs 配置
# ==========================================
MKDOCS_PORT=3002

# ==========================================
# 可选：使用本地 LLM
# ==========================================
# USE_LOCAL_LLM=true
# LOCAL_LLM_MODEL=llama2
